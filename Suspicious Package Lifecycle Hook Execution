Name: Supply Chain - Suspicious Package Lifecycle Hook Execution
Severity: High
QueryFrequency: 1h
QueryPeriod: 1h
MITRETactics: Execution
MITRETechniques: T1059.007
EntityMapping:
  - Device: DeviceName
  - Account: AccountName

DeviceProcessEvents
| where Timestamp > ago(1h)
| where InitiatingProcessFileName in~ (
    "node.exe", "npm.cmd", "npx.cmd", "bun.exe"
)
| where ProcessCommandLine has_any (
    "preinstall",
    "postinstall",
    "prepare",
    "prepack",
    "install"
)
| where ProcessCommandLine has_any (
    "bun run",
    "node index.js",
    "node ./index.js",
    "sh -c",
    "bash -c",
    "powershell",
    "cmd /c"
)
| project Timestamp, DeviceName, AccountName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine,
          InitiatingProcessParentFileName, ReportId
