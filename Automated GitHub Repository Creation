Name: Supply Chain - Automated GitHub Repository Creation
Severity: Medium
QueryFrequency: 1h
QueryPeriod: 1h
MITRETactics: Exfiltration
MITRETechniques: T1537
EntityMapping:
  - Device: DeviceName
  - Account: AccountName
  - URL: RemoteUrl


DeviceNetworkEvents
| where Timestamp > ago(1h)
| where RemoteUrl has "api.github.com"
| where RemoteUrl has_any (
    "/user/repos",
    "/orgs/",
    "/repos/"
)
| where InitiatingProcessFileName in~ (
    "node.exe", "bun.exe", "python.exe",
    "npm.cmd", "npx.cmd"
)
| where RemoteUrl !has "GET"
| project Timestamp, DeviceName, AccountName,
          RemoteUrl, RemoteIP,
          InitiatingProcessFileName,
          InitiatingProcessCommandLine, ReportId
