Name: Supply Chain - Obfuscated Script Execution from Package Manager
Severity: Medium
QueryFrequency: 1h
QueryPeriod: 1h
MITRETactics: DefenseEvasion
MITRETechniques: T1027
EntityMapping:
  - Device: DeviceName
  - Account: AccountName


DeviceProcessEvents
| where Timestamp > ago(1h)
| where InitiatingProcessFileName in~ (
    "node.exe", "npm.cmd", "npx.cmd", "bun.exe",
    "python.exe", "pip.exe"
)
| where ProcessCommandLine has_any (
    // Base64 encoding indicators
    "base64",
    "atob(",
    "btoa(",
    "Buffer.from",
    "fromCharCode",
    // Obfuscation patterns
    "eval(",
    "Function(",
    "globalThis.",
    // Compression
    "gzip",
    "zlib",
    // Crypto
    "AES",
    "RSA",
    "createCipheriv"
)
| project Timestamp, DeviceName, AccountName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine, ReportId
