Name: Supply Chain - Suspicious Mass Package Republish Activity
Severity: High
QueryFrequency: 1h
QueryPeriod: 1h
MITRETactics: Impact
MITRETechniques: T1195.002
EntityMapping:
  - Device: DeviceName
  - Account: AccountName


DeviceProcessEvents
| where Timestamp > ago(1h)
| where InitiatingProcessFileName in~ ("node.exe", "npm.cmd", "bun.exe")
| where ProcessCommandLine has_any (
    "npm publish",
    "npm version",
    "bun publish"
)
| summarize PublishCount = count(),
            PackageList = make_set(ProcessCommandLine) 
            by DeviceName, AccountName, bin(Timestamp, 10m)
| where PublishCount > 3
| project Timestamp, DeviceName, AccountName,
          PublishCount, PackageList
