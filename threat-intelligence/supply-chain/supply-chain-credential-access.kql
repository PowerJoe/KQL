// ============================================================
// Rule Name    : Supply Chain - Package Manager Credential File Access
// Platform     : Sentinel / MDE
// Severity     : High
// Frequency    : Every 1h
// Lookback     : 1h
// MITRE Tactic : CredentialAccess
// MITRE Tech   : T1552.001 - Unsecured Credentials: Credentials in Files
// Author       : PJ131
// Last Updated : 2026-05-19
// Description  : Detects package manager processes reading sensitive
//                credential files. Covers SSH keys, cloud credentials,
//                Kubernetes configs, Docker auth, npm tokens, and
//                generic secret files.
// ============================================================

DeviceFileEvents
| where Timestamp > ago(1h)
| where InitiatingProcessFileName in~ (
    "node.exe", "npm.cmd", "npx.cmd", "bun.exe",
    "python.exe", "pip.exe", "pip3.exe"
)
| where ActionType in ("FileRead", "FileAccessed")
| where FileName has_any (
    // SSH keys
    "id_rsa", "id_ed25519", "id_ecdsa",
    // Cloud credentials
    ".aws/credentials", ".aws/config",
    // Kubernetes
    "kubeconfig", ".kube/config",
    // Docker
    ".docker/config.json",
    // NPM tokens
    ".npmrc",
    // Git credentials
    ".git-credentials",
    // Generic secrets
    ".env", "secrets.json", "credentials.json",
    // Vault
    ".vault-token"
)
| project Timestamp, DeviceName, AccountName,
          FileName, FolderPath, ActionType,
          InitiatingProcessFileName,
          InitiatingProcessCommandLine, ReportId
